# ════════════════════════════════════════════════════════════════
#  APP-LEVEL SECRETS ONLY.
#  None of these are any individual user's GitHub token — those are
#  collected via OAuth at runtime and stored encrypted in Postgres.
#  These identify the APP itself to GitHub's OAuth system, sign the
#  stateless session cookie, and encrypt the token store.
# ════════════════════════════════════════════════════════════════

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# From your GitHub OAuth App (github.com/settings/developers -> New OAuth App)
# Authorization callback URL must be: {APP_BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your OpenRouter key — shared AI-fallback infra, not user-specific.
OPENROUTER_KEY=

# Public base URL this app is deployed at (no trailing slash).
# Local dev: http://localhost:5000
# Production: https://your-app.vercel.app
APP_BASE_URL=http://localhost:5000

# Neon Postgres connection string (neon.tech -> New Project -> copy the
# "Connection string" — use the POOLED one if offered, it suits Vercel's
# serverless/many-short-lived-connections pattern better).
# Looks like: postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Optional — set to "development" to relax cookie Secure flag for local
# HTTP testing. Leave unset (or anything else) in production.
FLASK_ENV=
