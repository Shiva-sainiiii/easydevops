# ════════════════════════════════════════════════════════════════
#  APP-LEVEL SECRETS ONLY.
#  None of these are any individual user's GitHub/Vercel/Render
#  token — those are collected via OAuth at runtime and stored
#  encrypted per-user in the database. These identify the APP
#  itself to GitHub's OAuth system, sign session cookies, and
#  encrypt the token store.
# ════════════════════════════════════════════════════════════════

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# From your GitHub OAuth App (github.com/settings/developers -> New OAuth App)
# Authorization callback URL must be: {APP_BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your OpenRouter key — shared AI-fallback infra, not user-specific.
OPENROUTER_KEY=

# Public base URL this app is deployed at (no trailing slash).
# Local dev: http://localhost:5000
# Production: https://your-app.onrender.com
APP_BASE_URL=http://localhost:5000

# Optional — set to "development" to relax cookie Secure flag for local
# HTTP testing. Leave unset (or anything else) in production.
FLASK_ENV=

# Optional — where the SQLite token-store file lives. Defaults to
# agent_users.db in the working directory. On Render, point this at a
# persistent disk mount if you add one, otherwise the DB resets on
# every deploy (fine for testing, not for real users).
DB_PATH=agent_users.db
